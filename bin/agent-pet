#!/usr/bin/env python3
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
# Roda dentro da pasta do plugin: __pycache__ ali faria o shell recarregar
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT))

from agent_pet.installer import check, setup


def main(argv):
    if argv == ["setup"]:
        return setup()
    # --yes: o painel já pediu a confirmação no botão
    if argv == ["setup", "--yes"]:
        return setup(assume_yes=True)
    if argv == ["check"]:
        return check()
    print("Uso: agent-pet setup [--yes] | agent-pet check", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
